    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.2",
    "electron-vite": "6.0.0",
    "graphology": "0.26.0",
    "graphology-layout-forceatlas2": "0.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-virtuoso": "4.18.19",
    "sigma": "4.0.3",
    "tailwindcss": "4.3.3",
    "vite": "8.3.4"
