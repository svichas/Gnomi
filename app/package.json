    "smoke:text": "electron-vite build && node text.smoke.ts",
    "smoke:profiles": "electron-vite build && node profiles.smoke.ts",
    "smoke:budget": "electron-vite build && node budget.smoke.ts",
    "perf:swarm": "electron-vite build && node swarm.perf.ts",
